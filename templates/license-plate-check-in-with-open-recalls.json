              "value": "=Customer: {{ $('Vehicle check-in form').item.json.Customer }}\nVIN: {{ $json.vehicle.vin }}\nRecalls issued for this vehicle: {{ $json.totalRecalls }}. None are open.",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
