          "conditions": [
            {
              "id": "27f4796a-2242-4440-833f-56738f8e25f8",
              "leftValue": "={{ $json.openRecalls }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
