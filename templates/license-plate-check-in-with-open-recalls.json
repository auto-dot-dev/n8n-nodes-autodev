              "name": "title",
              "value": "={{ $json.openRecalls }} open recall(s): {{ $json.vehicle.year }} {{ $json.vehicle.make }} {{ $json.vehicle.model }}",
              "type": "string"
            },
            {
              "id": "57d574dc-c525-4575-b4cb-abb33a05463e",
              "name": "message",
              "value": "=Customer: {{ $('Vehicle check-in form').item.json.Customer }}\nVIN: {{ $json.vehicle.vin }}\n\n{{ $json.data.map(r => (r.parkIt ? 'DO NOT DRIVE. ' : '') + (r.parkOutSide ? 'PARK OUTSIDE. ' : '') + r.component + ' (' + r.nhtsaCampaignNumber + '): ' + r.remedy).join('\\n\\n') }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        940,
        -40
      ],
      "id": "b7c55102-9e54-4fec-b019-ca5890cf811b",
      "name": "Summarize the recall work"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "e06261b5-c11a-4937-afb8-a976210ac075",
              "name": "title",
              "value": "=No open recalls: {{ $json.vehicle.year }} {{ $json.vehicle.make }} {{ $json.vehicle.model }}",
              "type": "string"
            },
            {
